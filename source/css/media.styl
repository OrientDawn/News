// --------------------------------------------
// 大屏平板:调整容器宽度
// --------------------------------------------
@media screen and (max-width: 1200px)
  .main .container
    max-width 100%
    padding-left 1.5rem
    padding-right 1.5rem

  .container-wide
    padding-left 1.5rem
    padding-right 1.5rem

  .article-content
    margin-left 0
    margin-right 0
    width 100%

// --------------------------------------------
// 平板及以下
// --------------------------------------------
@media screen and (max-width: 1023px)
  .main
    padding-top 0

  .container-wide
    padding-left 1rem
    padding-right 1rem

  .article-content
    margin-left 0
    margin-right 0
    width 100%
    padding-left 1.5rem
    padding-right 1.5rem

  .copyright-notice,
  .article-tags,
  .article-nav,
  .article-actions,
  .related-posts,
  .article-share
    margin-left 0
    margin-right 0
    width 100%
    padding-left 1rem
    padding-right 1rem

  .news-grid
    grid-template-columns repeat(2, 1fr)
    grid-auto-rows auto
    gap 1.25rem

  .news-card
    padding 1.25rem
    overflow visible
    .news-title
      font-size 1.1rem
      line-height 1.45
    .news-excerpt
      font-size 0.9rem
      line-height 1.7
      -webkit-line-clamp 4
    .news-category
      margin-bottom 0.75rem
    .news-meta
      margin-bottom 0.75rem

// --------------------------------------------
// 大手机 / 小平板:布局调整
// --------------------------------------------
@media screen and (max-width: 768px)
  html
    font-size 15px

  body
    padding-left 0
    padding-right 0

  .main .container
    padding-left 0.75rem
    padding-right 0.75rem

  .container-wide
    padding-left 0.75rem
    padding-right 0.75rem

  .hero-section
    padding 2.5rem 1rem
    margin-bottom 2rem
    background transparent
    &:before, &:after
      display none
    h1
      font-size 2.2rem
    p
      font-size 1.15rem
    .brand-logo
      max-width 320px

  .category-quick-nav
    flex-wrap wrap
    gap 0.75rem
    padding 1rem
    .nav-item
      flex 1 1 calc(50% - 0.75rem)
      min-width calc(50% - 0.75rem)
      padding 0.75rem 1rem
    .nav-icon
      width 34px
      height 34px

  .news-section
    .section-header
      margin-bottom 1rem
    h2
      font-size 1.4rem

  .news-grid
    grid-template-columns 1fr
    grid-auto-rows auto
    gap 1rem
    margin-left 0
    margin-right 0
    width 100%

  .news-card
    padding 1.25rem
    border-radius 14px
    overflow visible
    .news-title
      font-size 1.1rem
      line-height 1.5
      a
        -webkit-line-clamp 2
    .news-excerpt
      font-size 0.9rem
      line-height 1.7
      -webkit-line-clamp 4
    .news-category
      margin-bottom 0.75rem
    .news-meta
      margin-bottom 0.75rem
    .category-tag
      font-size 0.75rem
      padding 0.25rem 0.7rem
    &:hover
      transform none
      box-shadow 0 4px 20px rgba(0, 0, 0, 0.06)

  .page-header
    padding 1.25rem
    gap 0.875rem
    margin-top 1rem
    .page-header-icon
      width 48px
      height 48px
      min-width 48px
      border-radius 14px
      font-size 1.3rem
    .page-header-info
      min-width 0
    .archive-title
      font-size 1.4rem
      line-height 1.3
    .archive-subtitle
      font-size 0.85rem
      line-height 1.4

  .archive-header
    flex-direction column
    align-items stretch
    .archive-search-box
      width 100%
      .search-input
        width 100%

  .article-header-card
    padding 2.25rem 1.5rem 2rem
    margin-bottom 2rem
    .header-eyebrow
      margin-bottom 1rem
      .eyebrow-line
        width 32px
      .eyebrow-text
        font-size 0.72rem
    .post-title
      font-size 2.2rem
      margin-bottom 1.1rem
    .header-ornament
      margin-bottom 1.25rem
      .ornament-line
        width 24px
    .article-meta-row
      display none

  .article-content
    padding 1.5rem
    border-radius 8px
    overflow-x hidden
    h2
      font-size 1.3rem
      margin-top 1.5rem
    h3
      font-size 1.15rem
    p
      font-size 1.05rem
      line-height 1.75
    blockquote
      padding 1.2rem 1.2rem 1.2rem 2.6rem
      &:before
        left 0.8rem
        top 0.9rem
        font-size 1.2rem
    table
      display block
      width 100%
      overflow-x auto
      -webkit-overflow-scrolling touch
    th, td
      padding 5px 8px
      white-space nowrap

  .copyright-notice
    padding 1.2rem 1.25rem
    .notice-icon-wrap
      width 2rem
      height 2rem
      font-size 0.95rem
  .article-tags
    padding 1.25rem
    .tags-label
      font-size 0.9rem

  .article-nav
    grid-template-columns 1fr
    .nav-section
      min-height auto
      &.nav-next
        text-align left

  .article-actions
    flex-direction column
    gap 0.75rem
    .action-btn
      width 100%
      text-align center

  .related-posts
    .related-grid
      grid-template-columns repeat(auto-fit, minmax(160px, 1fr))
      gap 0.75rem

  .article-share
    .share-label
      display flex
      margin-bottom 0.6rem
      margin-right 0
    .share-buttons
      gap 0.5rem
    .wechat-qr
      right 1rem

  .categories-grid
    grid-template-columns 1fr

  .archive-page
    .archive-year-bar
      padding 0.8rem 1rem
    .archive-news-card
      padding 1.25rem

  .post-wrap
    padding-top 1rem
  article.post-wrap
    padding-top 0

  .year-nav
    padding 0.8rem 1rem
    gap 0.6rem
    .year-nav-label
      font-size 0.9rem
    .year-btn
      padding 0.4rem 0.7rem
      font-size 0.85rem

  .stats-grid
    grid-template-columns repeat(2, 1fr)
    gap 0.75rem
  .stat-item
    padding 1.25rem 1rem
    .stat-icon
      width 48px
      height 48px
      font-size 1.5rem
    .stat-number
      font-size 1.8rem

  .home-categories
    grid-template-columns 1fr
    gap 1rem

  .search-box
    max-width 100%

  .pagination
    gap 0.3rem
    a, span
      padding 0.5rem 0.85rem
      font-size 0.9rem
    .prev a, .next a
      padding 0.5rem 0.8rem

// --------------------------------------------
// 小屏手机:进一步紧凑
// --------------------------------------------
@media screen and (max-width: 480px)
  html
    font-size 14px

  body
    font-size 10pt

  .main .container
    padding-left 0.5rem
    padding-right 0.5rem

  .container-wide
    padding-left 0.5rem
    padding-right 0.5rem

  .hero-section
    padding 2rem 1rem
    h1
      font-size 1.9rem
    p
      font-size 1.1rem
    .brand-logo
      max-width 180px

  .category-quick-nav
    gap 0.5rem
    padding 0.75rem
    .nav-item
      flex 1 1 100%
      flex-direction row
      justify-content flex-start
      padding 0.6rem 0.75rem
      gap 0.5rem
    .nav-icon
      width 28px
      height 28px
    .nav-item span
      font-size 0.85rem

  .news-section .section-header
    flex-direction column
    align-items flex-start
    gap 0.5rem
    h2
      font-size 1.3rem

  .news-grid
    margin-left 0
    margin-right 0
    width 100%
    gap 0.75rem

  .news-card
    padding 1rem
    border-radius 12px
    .news-title
      font-size 1rem
      line-height 1.45
      a
        -webkit-line-clamp 2
    .news-excerpt
      font-size 0.85rem
      line-height 1.65
      -webkit-line-clamp 3
    .news-category
      margin-bottom 0.5rem
    .news-meta
      margin-bottom 0.5rem
    .category-tag
      font-size 0.7rem
      padding 0.2rem 0.6rem
    &:hover
      transform none

  .article-header-card
    padding 1.75rem 1rem 1.5rem
    .header-eyebrow
      margin-bottom 0.75rem
      .eyebrow-line
        width 24px
      .eyebrow-text
        font-size 0.65rem
        letter-spacing 0.14em
    .post-title
      font-size 1.7rem
      line-height 1.35
      margin-bottom 0.9rem
    .header-ornament
      margin-bottom 1rem
      .ornament-line
        width 20px
      .ornament-diamond
        width 6px
        height 6px

  .article-content
    padding 1.1rem
    border-radius 6px
    h2
      font-size 1.2rem
    h3
      font-size 1.05rem
    p
      font-size 1rem

  .copyright-notice
    padding 1rem
    .notice-icon-wrap
      width 1.8rem
      height 1.8rem
      font-size 0.85rem
    .notice-content
      font-size 0.9rem
  .article-tags
    padding 1rem
    .tags-inner
      gap 0.4rem

  .archive-title
    font-size 1.4rem
  .archive-subtitle
    font-size 0.85rem

  .page-header
    padding 1rem
    gap 0.75rem
    margin-top 0.75rem
    .page-header-icon
      width 40px
      height 40px
      min-width 40px
      border-radius 12px
      font-size 1.1rem
    .page-header-info
      min-width 0
    .archive-title
      font-size 1.25rem
      line-height 1.3
    .archive-subtitle
      font-size 0.8rem
      line-height 1.4

  .archive-header
    .archive-search-box
      .search-input
        width 100%

  .year-nav
    flex-direction column
    align-items flex-start
    gap 0.5rem
    .year-nav-list
      width 100%

  .stats-grid
    grid-template-columns 1fr

  .stat-item
    padding 1rem
    .stat-icon
      width 40px
      height 40px
      font-size 1.3rem
    .stat-number
      font-size 1.5rem

  .article-actions
    flex-direction column
    gap 0.75rem
    .action-btn
      width 100%
      text-align center
      box-sizing border-box

  .post-content blockquote.pullquote
    float none
    max-width 100%
    &.left, &.right
      float none
      text-align left

  .pagination
    .page-number:not(.current)
      display none
