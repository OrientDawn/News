.pagination 
  display flex
  flex-direction row
  justify-content center
  align-items center
  list-style none
  white-space nowrap
  width 100%
  padding-top 3em
  padding-bottom 1.5em
  gap 0.6rem

  li
    display flex
    align-items center
    justify-content center

  a, span
    -webkit-font-smoothing antialiased
    font-size 1rem
    font-weight 500
    padding 0.85rem 1.35rem
    text-decoration none
    border-radius 16px
    transition all 0.4s cubic-bezier(0.4, 0, 0.2, 1)
    color $light-font-secondary-color
    min-width 2.75rem
    text-align center
    position relative
    overflow hidden

    &:before
      content ""
      position absolute
      top 0
      left 0
      width 100%
      height 100%
      background linear-gradient(135deg, rgba(201, 169, 97, 0.1), rgba(0, 102, 204, 0.05))
      transform scaleX(0)
      transition transform 0.4s ease
      z-index 0

    &:hover:before
      transform scaleX(1)

  .prev, .next
    a
      background linear-gradient(145deg, #ffffff, #f8f9fa)
      color $light-font-secondary-color
      font-size 1.2rem
      padding 0.85rem 1.2rem
      border 1px solid rgba(201, 169, 97, 0.1)
      box-shadow 0 2px 8px rgba(0, 0, 0, 0.04)

      &:hover
        background linear-gradient(135deg, #c9a961, #b8964a)
        color white
        border-color #c9a961
        box-shadow 0 8px 24px rgba(201, 169, 97, 0.35)
        transform translateX(-4px)

  .next a:hover
    transform translateX(4px)

  .prev.disabled a,
  .next.disabled a
    opacity 0.3
    cursor not-allowed
    transform none
    background #f5f5f5
    border-color transparent

    &:hover
      background #f5f5f5
      color $light-font-secondary-color
      box-shadow none
      border-color transparent

  .page-number
    a
      background linear-gradient(145deg, #ffffff, #f8f9fa)
      border 1px solid rgba(201, 169, 97, 0.15)
      box-shadow 0 2px 8px rgba(0, 0, 0, 0.04)
      font-weight 600

      &:hover
        background rgba(201, 169, 97, 0.08)
        color #c9a961
        border-color rgba(201, 169, 97, 0.4)
        transform translateY(-2px)
        box-shadow 0 4px 12px rgba(201, 169, 97, 0.15)

    &.current
      a
        background linear-gradient(135deg, #c9a961, #b8964a)
        color white
        border-color #c9a961
        font-weight 700
        box-shadow 0 6px 20px rgba(201, 169, 97, 0.4)

        &:hover
          transform translateY(-2px)
          box-shadow 0 8px 24px rgba(201, 169, 97, 0.5)

    &.disabled
      display none

