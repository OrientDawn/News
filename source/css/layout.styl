.wrapper 
  display flex
  flex-direction column
  min-height 100vh
  width 100%

.main 
  flex-grow 1
  flex-shrink 0
  flex-basis auto
  display flex
  flex-direction column
  .container
    max-width 1200px
    margin 0 auto
    padding-left 1.5em
    padding-right 1.5em
    height 100%
    display flex
    flex-direction column
    flex 1

  .container-wide
    max-width 100%
    margin 0
    padding-left 2rem
    padding-right 2rem
    height 100%
    display flex
    flex-direction column
    flex 1