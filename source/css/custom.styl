  color #c9a961
  font-size 0.85rem
  font-weight 500
  border-radius 20px
  margin-right 0.5rem
  transition all 0.3s ease

  &:hover
    background linear-gradient(135deg, #c9a961, #b8964a)
    color white
    transform scale(1.05)

.news-title
