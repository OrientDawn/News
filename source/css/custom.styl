    border-radius 25px
    text-decoration none
    transition all 0.3s cubic-bezier(0.4, 0, 0.2, 1)
    border 1px solid transparent
    position relative
    overflow hidden
    font-size clamp(12px, 1rem, 24px) !important

    &:before
      content ""
      position absolute
      top 0
      left 0
      width 100%
      height 2px
      background linear-gradient(90deg, #c9a961, #0066cc)
      transform scaleX(0)
      transition transform 0.3s ease

    &:hover
      background linear-gradient(135deg, #c9a961, #b8964a)
      color white
      transform translateY(-3px) scale(1.05)
      box-shadow 0 8px 20px rgba(201, 169, 97, 0.35)
      border-color rgba(201, 169, 97, 0.3)

      &:before
        transform scaleX(1)

    .tag-count
      font-size 0.75rem
      opacity 0.7
      background rgba(201, 169, 97, 0.15)
      padding 0.15rem 0.4rem
      border-radius 10px

    &:hover .tag-count
      background rgba(255, 255, 255, 0.2)
      opacity 1

.stats-section
  margin-bottom 2.5rem

.stats-grid
  display grid
  grid-template-columns repeat(auto-fit, minmax(200px, 1fr))
  gap 1.2rem

.stat-item
  background white
  border-radius 20px
  padding 2rem 1.5rem
  display flex
  flex-direction column
  align-items center
  text-align center
  box-shadow 0 4px 20px rgba(0, 0, 0, 0.06)
  transition all 0.4s cubic-bezier(0.4, 0, 0.2, 1)
  border 1px solid rgba(201, 169, 97, 0.08)
  position relative
  overflow hidden

  &:before
    content ""
    position absolute
    top 0
    left 0
    right 0
    height 4px
    background linear-gradient(90deg, #c9a961, #0066cc, #6bb89a)
    opacity 0
    transition opacity 0.3s ease

  &:hover
    transform translateY(-6px) scale(1.02)
    box-shadow 0 12px 32px rgba(201, 169, 97, 0.25)
    border-color rgba(201, 169, 97, 0.2)

    &:before
      opacity 1

  .stat-icon
    width 60px
    height 60px
    border-radius 16px
    display flex
    align-items center
    justify-content center
    font-size 2rem
    margin-bottom 1rem
    background linear-gradient(135deg, rgba(201, 169, 97, 0.1), rgba(0, 102, 204, 0.1))
    color $light-global-link-hover-color
    transition all 0.3s ease

    &:hover
      transform scale(1.15) rotate(5deg)

  .stat-content
    .stat-number
      font-size 2.5rem
      font-weight 800
      color $light-font-color
      display block
      background linear-gradient(135deg, #c9a961, #b8964a)
      -webkit-background-clip text
      -webkit-text-fill-color transparent
      background-clip text
      transition all 0.3s ease

    .stat-label
      font-size 0.95rem
      color $light-font-secondary-color
      font-weight 500
      margin-top 0.3rem

  &:hover .stat-number
    transform scale(1.1)

.reading-progress
  position fixed
  top 0
  left 0
  width 100%
  height 4px
  background rgba(201, 169, 97, 0.08)
  z-index 9999
  box-shadow 0 2px 8px rgba(201, 169, 97, 0.1)

  .progress-bar
    height 100%
    background linear-gradient(90deg, #c9a961, #d4af37, #0066cc)
    width 0%
    transition width 0.3s ease
    border-radius 0 2px 2px 0
    box-shadow 0 0 10px rgba(201, 169, 97, 0.5)

.page-header
  display flex
  align-items center
  gap 1.5rem
  padding 2rem
  margin-top 2rem
  margin-bottom 2rem
  background white
  border-radius 20px
  box-shadow 0 4px 24px rgba(0, 0, 0, 0.06)
  border 1px solid rgba(201, 169, 97, 0.08)
  position relative
  overflow hidden

  &:before
    content ""
    position absolute
    top 0
    left 0
    width 4px
    height 100%
    background linear-gradient(180deg, #c9a961, #b8964a)
    border-radius 2px

  .page-header-icon
    width 64px
    height 64px
    min-width 64px
    border-radius 18px
    display flex
    align-items center
    justify-content center
    font-size 1.6rem
    background linear-gradient(135deg, rgba(201, 169, 97, 0.18), rgba(201, 169, 97, 0.08))
    color #c9a961
    transition transform 0.3s ease

    &:hover
      transform scale(1.1) rotate(-5deg)

  .page-header-info
    flex 1
    min-width 0

.archive-title
  font-size 2rem
  font-weight 800
  color $light-font-color
  margin 0 0 0.3rem
  background linear-gradient(135deg, #c9a961, #b8964a)
  -webkit-background-clip text
  -webkit-text-fill-color transparent
  background-clip text

.archive-subtitle
  font-size 1rem
  color $light-font-secondary-color
  margin 0
  line-height 1.5

.archive-header
  display flex
  justify-content space-between
  align-items center
  margin-bottom 2.5rem
  flex-wrap wrap
  gap 1.5rem

.archive-search-box
    display flex
    align-items center
    background white
    border-radius 30px
    padding 0.5rem 1.5rem
    box-shadow 0 4px 20px rgba(201, 169, 97, 0.1)
    border 2px solid transparent
    transition all 0.3s cubic-bezier(0.4, 0, 0.2, 1)

    &:focus-within
      box-shadow 0 8px 32px rgba(201, 169, 97, 0.25)
      border-color rgba(201, 169, 97, 0.3)

    i
      color $light-font-secondary-color
      font-size 1rem
      margin-right 0.6rem

    &:focus-within i
      color #c9a961

    .search-input
      border none
      outline none
      font-size 1rem
      background transparent
      width 220px
      color $light-font-color

.year-nav
  display flex
  align-items center
  gap 1.2rem
  margin-bottom 2.5rem
  padding 1.2rem 1.5rem
  background white
  border-radius 16px
  box-shadow 0 4px 20px rgba(0, 0, 0, 0.06)
  flex-wrap wrap
  border 1px solid rgba(201, 169, 97, 0.08)

  .year-nav-label
    font-size 1rem
    color $light-font-color
    font-weight 600
    white-space nowrap

  .year-nav-list
    display flex
    gap 0.6rem
    flex-wrap wrap

  .year-btn
    padding 0.5rem 1rem
    border none
    border-radius 25px
    background #f0f1f2
    color $light-font-color
    font-size 0.95rem
    font-weight 500
    cursor pointer
    transition all 0.3s cubic-bezier(0.4, 0, 0.2, 1)
    border 1px solid transparent

    &:hover
      background #e4e5e7
      transform translateY(-2px)
      box-shadow 0 6px 16px rgba(201, 169, 97, 0.2)
      border-color rgba(201, 169, 97, 0.2)

    &.active
      color white
      background linear-gradient(135deg, #c9a961, #b8964a)
      box-shadow 0 6px 20px rgba(201, 169, 97, 0.35)
      border-color rgba(201, 169, 97, 0.3)

.no-results
  text-align center
  padding 4rem 2rem
  color $light-font-secondary-color

  i
    font-size 3rem
    margin-bottom 1rem
    opacity 0.4

  p
    font-size 1.1rem

