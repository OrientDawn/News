.highlight
    color: #1a1a2e
    background: #ffffff
    .code
        /* Comment */
        .comment,
        .quote
            color: #5a6a7a

        /* Red - variable / tag / attribute / regexp / link */
        .variable,
        .template-variable,
        .attribute,
        .tag,
        .name,
        .regexp,
        .link,
        .selector-id,
        .selector-class
            color: #c7254e

        /* Amber - number / meta / built_in / literal / type / params */
        .number,
        .meta,
        .built_in,
        .builtin-name,
        .literal,
        .type,
        .params
            color: #b08400

        /* Green - string / symbol / bullet */
        .string,
        .symbol,
        .bullet
            color: #1a7f37

        /* Blue - title / section (function names) */
        .title,
        .section
            color: #0066cc

        /* Purple - keyword / selector-tag */
        .keyword,
        .selector-tag
            color: #6f42c1

        .emphasis
            font-style: italic

        .strong
            font-weight: bold
