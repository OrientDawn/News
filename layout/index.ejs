<div class="container">
    <div class="hero-section">
        <% if (theme.logo) { %>
            <div class="logo-container">
                <img src="<%- url_for(theme.logo) %>" alt="<%= config.title %>" class="brand-logo">
            </div>
        <% } %>
        <h1><%- config.title %></h1>
        <p><%- config.subtitle %></p>
    </div>

    <div class="search-section">
        <div class="search-box">
            <i class="fas fa-search search-icon"></i>
            <input type="text" id="search-input" placeholder="搜索新闻..." class="search-input">
            <button id="search-btn" class="search-btn"><i class="fas fa-search"></i></button>
        </div>
    </div>

    <div class="category-quick-nav">
        <a href="/categories/公司动态/" class="nav-item">
            <div class="nav-icon nav-icon-company"><i class="fas fa-building"></i></div>
            <span>公司动态</span>
        </a>
        <a href="/categories/行业资讯/" class="nav-item">
            <div class="nav-icon nav-icon-industry"><i class="fas fa-newspaper"></i></div>
            <span>行业资讯</span>
        </a>
        <a href="/categories/通知公告/" class="nav-item">
            <div class="nav-icon nav-icon-notice"><i class="fas fa-bell"></i></div>
            <span>通知公告</span>
        </a>
        <a href="/archives" class="nav-item">
            <div class="nav-icon nav-icon-news"><i class="fas fa-list-alt"></i></div>
            <span>新闻动态</span>
        </a>
    </div>

    <div class="stats-section">
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-icon"><i class="fas fa-newspaper"></i></div>
                <div class="stat-content">
                    <span class="stat-number" data-target="<%= site.posts.length %>">0</span>
                    <span class="stat-label">新闻总数</span>
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-icon"><i class="fas fa-folder"></i></div>
                <div class="stat-content">
                    <span class="stat-number" data-target="<%= site.categories.length %>">0</span>
                    <span class="stat-label">分类数量</span>
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-icon"><i class="fas fa-tags"></i></div>
                <div class="stat-content">
                    <span class="stat-number" data-target="<%= site.tags.length %>">0</span>
                    <span class="stat-label">标签数量</span>
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-icon"><i class="fas fa-calendar"></i></div>
                <div class="stat-content">
                    <span class="stat-number" data-target="<%= new Date().getFullYear() - 2026 + 1 %>">0</span>
                    <span class="stat-label">运营年数</span>
                </div>
            </div>
        </div>
    </div>

    <div class="home-categories">
        <div class="home-category-card company-card">
            <div class="category-header">
                <i class="fas fa-building category-icon"></i>
                <h3>公司动态</h3>
                <a href="/categories/公司动态/" class="category-more">更多 →</a>
            </div>
            <div class="category-list">
                <% site.categories.each(function(cat) { %>
                    <% if (cat.name === '公司动态') { %>
                        <% cat.posts.slice(0, 5).each(function(post) { %>
                            <a href="<%- url_for(post.path) %>" class="category-item">
                                <span class="item-title"><%= post.title %></span>
                                <span class="item-date"><%- date(post.date, 'MM-DD') %></span>
                            </a>
                        <% }) %>
                    <% } %>
                <% }) %>
            </div>
        </div>

        <div class="home-category-card industry-card">
            <div class="category-header">
                <i class="fas fa-newspaper category-icon"></i>
                <h3>行业资讯</h3>
                <a href="/categories/行业资讯/" class="category-more">更多 →</a>
            </div>
            <div class="category-list">
                <% site.categories.each(function(cat) { %>
                    <% if (cat.name === '行业资讯') { %>
                        <% cat.posts.slice(0, 5).each(function(post) { %>
                            <a href="<%- url_for(post.path) %>" class="category-item">
                                <span class="item-title"><%= post.title %></span>
                                <span class="item-date"><%- date(post.date, 'MM-DD') %></span>
                            </a>
                        <% }) %>
                    <% } %>
                <% }) %>
            </div>
        </div>

        <div class="home-category-card notice-card">
            <div class="category-header">
                <i class="fas fa-bell category-icon"></i>
                <h3>通知公告</h3>
                <a href="/categories/通知公告/" class="category-more">更多 →</a>
            </div>
            <div class="category-list">
                <% site.categories.each(function(cat) { %>
                    <% if (cat.name === '通知公告') { %>
                        <% cat.posts.slice(0, 5).each(function(post) { %>
                            <a href="<%- url_for(post.path) %>" class="category-item">
                                <span class="item-title"><%= post.title %></span>
                                <span class="item-date"><%- date(post.date, 'MM-DD') %></span>
                            </a>
                        <% }) %>
                    <% } %>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="hot-tags-section">
        <div class="section-header">
            <h2><i class="fas fa-tags"></i> 热门标签</h2>
        </div>
        <div class="hot-tags">
            <% site.tags.sort('length', 'desc').each(function(tag) { %>
                <a href="<%- url_for(tag.path) %>" class="tag-item" style="font-size: <%= Math.min(12 + tag.length * 0.5, 24) %>px;">
                    <%= tag.name %>
                    <span class="tag-count"><%= tag.length %></span>
                </a>
            <% }) %>
        </div>
    </div>

</div>