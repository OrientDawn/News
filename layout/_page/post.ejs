<div class="container-wide">
    <div class="reading-progress">
        <div class="progress-bar" id="progress-bar"></div>
    </div>

    <%
        var stripHtml = function(html){ return String(html || '').replace(/<[^>]*>/g, '').replace(/\s+/g, '').trim(); };
        var readTime = Math.max(1, Math.ceil(stripHtml(page.content).length / 400));
        var relatedPosts = [];
        if (page.tags && page.tags.length) {
            var postTagNames = page.tags.map(function(t){ return t.name; });
            var allPosts = site.posts.toArray();
            relatedPosts = allPosts.filter(function(p){
                if (p.path === page.path) return false;
                if (!p.tags || !p.tags.length) return false;
                return p.tags.some(function(t){ return postTagNames.indexOf(t.name) >= 0; });
            }).sort(function(a, b){ return new Date(b.date) - new Date(a.date); }).slice(0, 3);
        }
    %>
    <%# article %>
    <article class="post-wrap">
        <header class="article-header-card">
            <div class="header-eyebrow">
                <span class="eyebrow-line"></span>
                <span class="eyebrow-text">正文</span>
                <span class="eyebrow-line"></span>
            </div>
            <h1 class="post-title"><%= page.title %></h1>
            <div class="header-ornament" aria-hidden="true">
                <span class="ornament-dot"></span>
                <span class="ornament-line"></span>
                <span class="ornament-diamond"></span>
                <span class="ornament-line"></span>
                <span class="ornament-dot"></span>
            </div>
            <div class="article-meta-row">
                <% if(theme.post_author_enable && config.author){ %>
                    <span class="article-author">
                        <span class="meta-icon"><i class="fas fa-user"></i></span>
                        <span><%- config.author %></span>
                    </span>
                <% } %>
                <% if(page.date && theme.post_date_enable){ %>
                    <span class="article-date">
                        <span class="meta-icon"><i class="fas fa-calendar"></i></span>
                        <span><%- date(page.date, theme.date_format) %></span>
                    </span>
                <% } %>
                <span class="article-reading">
                    <span class="meta-icon"><i class="fas fa-book-open"></i></span>
                    <span>约 <%= readTime %> 分钟阅读</span>
                </span>
            </div>
        </header>

        <div class="post-content article-content">
            <%- page.content %>
        </div>

        <% if(theme.post_copyright_enable){ %>
            <section class="copyright-notice">
                <div class="notice-icon-wrap"><i class="fas fa-copyright"></i></div>
                <div class="notice-header">
                    <span>版权声明</span>
                </div>
                <div class="notice-content">
                    <p>本文由 <strong><%- config.author %></strong> 原创发布，全文文字、配图、数据、版式等全部内容知识产权归属启明曙光科技有限公司，受著作权法、民法典及相关国际公约保护，未经我方书面授权，任何机构、媒体、个人不得转载、摘编、篡改、商用发布。</p>
                    <p>原文链接：<a href="<%- page.permalink %>"><%- page.permalink %></a></p>
                </div>
            </section>
        <% } %>

        <section class="post-tags article-tags">
            <div class="tags-inner">
                <span class="tags-label">
                    <i class="fas fa-tags"></i>
                    <span>本文标签</span>
                </span>
                <span class="tags-list">
                    <% if(page.tags.length!==0){%>
                    <% page.tags.forEach(item=>{ %>
                        <a href="<%- url_for(item.path) %>" class="tag-item"><%- item.name %></a>
                    <% }) %>
                    <% } else { %>
                        <span class="no-tags">暂无标签</span>
                    <% } %>
                </span>
            </div>
        </section>

        <section class="article-nav">
            <a class="nav-section nav-prev<% if(!post.prev){ %> nav-disabled<% } %>"<% if(post.prev){ %> rel="prev" href="<%- url_for(post.prev.path)%>"<% } %>>
                <span class="nav-direction"><i class="fas fa-arrow-left"></i> 上一篇</span>
                <span class="nav-title"><% if(post.prev){ %><%- post.prev.title%><% } else { %>已是最早文章<% } %></span>
            </a>
            <a class="nav-section nav-next<% if(!post.next){ %> nav-disabled<% } %>"<% if(post.next){ %> rel="next" href="<%- url_for(post.next.path)%>"<% } %>>
                <span class="nav-direction">下一篇 <i class="fas fa-arrow-right"></i></span>
                <span class="nav-title"><% if(post.next){ %><%- post.next.title%><% } else { %>已是最新文章<% } %></span>
            </a>
        </section>

        <% if(relatedPosts.length){ %>
        <section class="related-posts">
            <div class="related-header">
                <span class="related-header-icon"><i class="fas fa-bookmark"></i></span>
                <h3>相关推荐</h3>
                <span class="related-header-line"></span>
            </div>
            <div class="related-grid">
                <% relatedPosts.forEach(function(p){ %>
                <a href="<%- url_for(p.path) %>" class="related-card">
                    <span class="related-category">
                        <% if(p.categories && p.categories.length){ %><%- p.categories.first().name %><% } else { %>文章<% } %>
                    </span>
                    <span class="related-title"><%- p.title %></span>
                    <span class="related-date"><i class="far fa-calendar"></i> <%- date(p.date, theme.date_format) %></span>
                </a>
                <% }) %>
            </div>
        </section>
        <% } %>
        <section class="article-actions">
            <a href="javascript:window.history.back();" class="action-btn btn-back"><i class="fas fa-arrow-left"></i> 返回</a>
            <a href="<%- config.root %>" class="action-btn btn-home"><i class="fas fa-home"></i> 首页</a>
            <a href="#top" class="action-btn btn-top" id="btn-back-to-top"><i class="fas fa-arrow-up"></i> 顶部</a>
        </section>
    </article>
</div>