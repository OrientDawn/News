<% if (page.total > 1){ %>
    <nav class="pagination">
        <%- paginator({
            prev_text: '<i class="fas fa-chevron-left"></i>',
            next_text: '<i class="fas fa-chevron-right"></i>',
            prev_next: true,
            end_size: 1,
            mid_size: 2,
            escape: false
        }) %>
    </nav>
<% } %>